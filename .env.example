# Optional persistent RSA key pair for the hybrid request encryption layer.
# Store PEM newlines as literal \n when setting these in a single-line environment variable.
RSA_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
RSA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Required server-only secrets. Never expose these to the client bundle.
XO_ADMIN_USERNAME="admin"
XO_ADMIN_PASSWORD_HASH="sha256(xo-studio:<your-password>)"
XO_PROJECT_PASSWORD_SECRET="replace-with-a-random-32-byte-secret"

# Email stays disabled until the old provider credential is revoked and a new one is configured.
XO_EMAIL_ENABLED="false"
SMTP_PASS=""
